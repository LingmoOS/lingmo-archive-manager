[Desktop Entry]
Type=Application
Name=Archive Manager
GenericName=Archive Manager
Comment=Browse, create and extract compressed archives
Exec=lingmo-archive-manager -- %F
Icon=lingmo-archive-manager
Terminal=false
Categories=Utility;Archiving;Compression;
MimeType=application/zip;application/x-tar;application/gzip;application/x-gzip;application/x-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/x-bzip2;application/x-bzip-compressed-tar;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/zstd;
Keywords=archive;zip;tar;compress;extract;
StartupNotify=true
StartupWMClass=lingmo-archive-manager
