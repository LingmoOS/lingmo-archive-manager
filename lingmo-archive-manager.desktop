[Desktop Entry]
Version=1.0
Name=Archive Manager
Name[zh_CN]=鍘嬬缉绠＄悊鍣?Comment=Open, extract and create archives
Exec=lingmo-archive-manager %U
Icon=lingmo-archive-manager
Terminal=false
Type=Application
Categories=Utility;Archiving;Compression;
